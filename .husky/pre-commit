#!/usr/bin/env sh
set -eu

# Only inspect staged changes; unstaged working-tree content must not affect commits.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# Prevent accidental commits of real environment files (allow .env.example).
if printf '%s\n' "$staged" | grep -Eq '(^|/)\.env($|\.[^.]+$)' &&
   printf '%s\n' "$staged" | grep -Ev '(^|/)\.env(\.example|\.sample|\.template)$' | grep -Eq '(^|/)\.env($|\.[^.]+$)'; then
  echo 'ERROR: A local .env file is staged.' >&2
  exit 1
fi

# Scan the index, not potentially different working-tree files.
printf '%s\n' "$staged" | while IFS= read -r path; do
  [ -n "$path" ] || continue
  if git show ":$path" 2>/dev/null | grep -Eq '(PRIVATE_KEY|SECRET_KEY|API_KEY|ACCESS_TOKEN|PASSWORD)[[:space:]]*=[[:space:]]*[^[:space:]]{8,}'; then
    echo "ERROR: Potential secret staged in $path" >&2
    exit 1
  fi
done

if printf '%s\n' "$staged" | grep -Eq '^contracts/.*\.rs$'; then
  (cd contracts && cargo fmt --all -- --check)
fi

if printf '%s\n' "$staged" | grep -Eq '^frontend-scaffold/src/'; then
  (cd frontend-scaffold && npx --no-install lint-staged)
fi
if printf '%s\n' "$staged" | grep -Eq '^backend/'; then
  (cd backend && npx --no-install lint-staged)
fi
